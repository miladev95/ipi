{
  "manifest_version": 3,
  "name": "IP Information",
  "version": "1.0.0",
  "description": "Fetch and display your IP address and location information",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://ipapi.co/*",
    "https://ipwho.is/*",
    "https://free.freeipapi.com/*",
    "https://ipinfo.io/*",
    "https://ifconfig.co/*",
    "https://api.country.is/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IP Information"
  }
}
